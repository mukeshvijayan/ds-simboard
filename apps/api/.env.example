# Copy to .env and fill in for a real deployment. Not needed for
# development or tests — those use an embedded database (see
# docs/architecture/0009-*.md) and need no credentials at all.

# A real Postgres connection string. No hosting provider is decided yet —
# Vercel Postgres, Supabase, Neon, Railway, and self-hosted are all
# reasonable options; this is a product/cost decision for the project
# owner, not made in code.
DATABASE_URL=

# Signs/verifies session cookies (see docs/architecture/0010-*.md). Must
# be a long random value in production — anyone who knows it can forge a
# session cookie for any user id. Tests use a fixed dev-only value and
# never read this variable. Generate one with e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

PORT=3001
