# Copy to .env for local development against a real database, or set
# these directly in Vercel's dashboard for the deployed environment (see
# docs/architecture/0015-*.md). Not needed for tests — those use an
# embedded database (see docs/architecture/0009-*.md) and need no
# credentials at all.

# A real Postgres connection string. Production uses Supabase
# (ap-northeast-2), via its transaction-mode connection pooler — the
# right choice behind a serverless deployment, since it avoids exhausting
# Postgres's own connection limit across many concurrent function
# invocations. See docs/architecture/0015-*.md for the full reasoning.
DATABASE_URL=

# Signs/verifies session cookies (see docs/architecture/0010-*.md). Must
# be a long random value in production — anyone who knows it can forge a
# session cookie for any user id. Tests use a fixed dev-only value and
# never read this variable. Generate one with e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Only used by `src/server.ts` (a local/traditional-host run). The Vercel
# deployment (`api/index.ts`) doesn't use this — Vercel assigns its own
# port internally.
PORT=3001

# apps/web's real origin(s), comma-separated, for CORS (see
# docs/architecture/0029-*.md) — apps/web and apps/api deploy as two
# separate Vercel projects (ADR 0015) with no shared domain, so session
# cookies never reach this API cross-origin without this. Defaults to
# the local Next.js dev origin (http://localhost:3000) if unset — only
# needs setting explicitly once apps/web has a real deployed domain.
WEB_APP_ORIGIN=
